# Copy this file to .env and fill in whichever keys you have.
# You only need ONE of these for Smart mode to work — set up two or three
# for redundancy (if one is down or rate-limited, the next is tried).
# All three have a genuinely free tier with no credit card required.
# See README.md -> "Smart mode" for exactly how to get each key.

GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=

# Optional: override the default model for each provider.
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.0-flash-lite
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# HF_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Optional: try several Hugging Face models in order instead of just one
# (comma-separated, no spaces needed). If one is cold/asleep it's skipped
# in a few seconds and the next is tried. Overrides HF_MODEL above.
# Defaults to 6 solid free models if you don't set this at all.
# HF_MODELS=meta-llama/Llama-3.3-70B-Instruct,meta-llama/Llama-3.1-8B-Instruct,mistralai/Mistral-7B-Instruct-v0.3,Qwen/Qwen2.5-7B-Instruct,google/gemma-2-9b-it,HuggingFaceH4/zephyr-7b-beta
